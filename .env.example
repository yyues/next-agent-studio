# ============================================================
# MongoDB 连接（二选一）
# ============================================================

# 方式一：完整连接字符串（优先）。带账号密码时格式：
# mongodb://用户名:密码@主机:端口/?authSource=认证库
# 密码中的特殊字符需 URL 编码，例如 @ 写成 %40
# MONGODB_URI=mongodb://root:secret%40123@127.0.0.1:27017/?authSource=admin

# 方式二：分离配置项（未设置 MONGODB_URI 时使用，便于含特殊字符的密码）
MONGODB_HOST=127.0.0.1
MONGODB_PORT=27017
# 可选：用户名 + 密码（留空则无认证）
MONGODB_USER=
MONGODB_PASSWORD=
# 认证库，有账号时一般用 admin
MONGODB_AUTH_SOURCE=admin
# 数据库名
MONGODB_DB=agent_demo

# ============================================================
# JWT 鉴权
# ============================================================
# 密钥（请用随机长字符串，可用 `openssl rand -base64 32` 生成）
JWT_SECRET=change-me-to-a-long-random-secret
# JWT 过期时间
JWT_EXPIRES_IN=7d

# ============================================================
# 用户配置加密
# ============================================================
# 用于加密保存在数据库中的用户 API Key（AES-256-GCM）
# 请用随机长字符串，未设置时 fallback 用 JWT_SECRET（生产环境务必单独设置）
# 可用 `openssl rand -base64 32` 生成
ENCRYPTION_KEY=change-me-to-another-random-secret

# ============================================================
# 游客模式
# ============================================================
# 是否允许未登录用户使用 AI 对话（true 允许，false 必须登录）
# 游客对话不持久化到数据库，刷新即丢失
ALLOW_GUEST_CHAT=true

# ============================================================
# OpenRouter / LLM 提供商
# ============================================================
# 项目默认 API Key（申请：https://openrouter.ai/keys）
# 当用户未提供自己的 key 时使用；为空且用户也未提供则报错
OPENROUTER_API_KEY=sk-or-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 项目默认 API 路径（Base URL）
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# 默认模型（OpenRouter 上的模型 ID，或用户自定义 API 兼容端点支持的模型 ID）
DEFAULT_MODEL=openai/gpt-4o-mini
