OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MONGODB_URI=mongodb://127.0.0.1:27017/assistant_demo

# 网页标题(浏览器标签页显示的应用名),留空默认 Agent Studio
APP_TITLE=Agent Studio

# 登录凭据(登录页用户名/密码),留空默认 admin / admin123
AUTH_USERNAME=admin
AUTH_PASSWORD=admin123
# Cookie 签名密钥,建议设置为随机长字符串(缺省由用户名密码派生)
AUTH_SECRET=

# 数据库敏感字段(provider apiKey / MCP 请求头)的加密密钥,建议随机长字符串。
# 优先级:ENCRYPTION_KEY → AUTH_SECRET → 登录凭据派生;更换后旧密文将无法解密
# 生成示例:openssl rand -base64 32
ENCRYPTION_KEY=

# If your MongoDB requires auth, you can use full URI:
# MONGODB_URI=mongodb://username:password@127.0.0.1:27017/assistant_demo?authSource=admin

# Or set split fields (used when MONGODB_URI is empty):
# MONGODB_HOST=127.0.0.1
# MONGODB_PORT=27017
# MONGODB_DB=assistant_demo
# MONGODB_USERNAME=root
# MONGODB_PASSWORD=your_password
# MONGODB_AUTH_SOURCE=admin
# If omitted and username/password are provided, authSource defaults to admin.

# Optional default provider values (used when user has no saved settings)
DEFAULT_PROVIDER_NAME=openai-compatible
DEFAULT_PROVIDER_BASE_URL=https://api.openai.com/v1
DEFAULT_PROVIDER_MODEL=gpt-5.6-luna
# Optional. If empty, falls back to OPENAI_API_KEY
DEFAULT_PROVIDER_API_KEY=

# Vercel Blob: 存储 skill / resource 上传的文件内容
# 开发与生产统一走 Vercel Blob,必须配置此 token 才能上传/读取用户上传的 skill 与 resource
# 在 Vercel 项目 Storage → 创建 Blob Store 后复制 token 填入
BLOB_READ_WRITE_TOKEN=

